# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Plain-English: these are the settings the app reads when it starts.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Plain-English: where the app stores its data. Default works with docker-compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revenue_leakage
POSTGRES_USER=rl_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://rl_app:change_me@localhost:5432/revenue_leakage

# --- LLM provider (OpenAI-compatible) ---------------------------------------
# Plain-English: which AI model does the reading and explaining.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, OpenRouter, local server).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
# Model used for narrative writing. Falls back to LLM_MODEL if unset.
LLM_MODEL_NARRATIVE=
# Embedding model used to turn contract clauses into vectors.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Offline / test mode ----------------------------------------------------
# Plain-English: when true, no network calls are made. Tests always run offline.
LLM_MOCK=0
CUAD_OFFLINE=1

# --- CUAD real-data fetch ---------------------------------------------------
# Plain-English: the real public contract dataset used for testing (see ADR-007).
# Downloaded files are cached outside the repo and never committed.
CUAD_ZENODO_URL=https://zenodo.org/records/4595826/files/CUAD_v1.zip?download=1
CUAD_ZENODO_MD5=c38f490a984420b8a62600db401fafd5
CUAD_MAX_CONTRACTS=100
CUAD_CACHE_DIR=data/cuad

# --- Cloudflare AI Search (optional comparison baseline, see ADR-009) -------
# Plain-English: optional. Used ONLY to compare our own search against a
# managed service. Leave blank and the comparison is skipped.
CF_ACCOUNT_ID=
CF_AI_SEARCH_INSTANCE_ID=
CF_API_TOKEN=

# --- Detection tuning -------------------------------------------------------
# Plain-English: how confident the case must be before it is auto-confirmed.
CONFIDENCE_HIGH_THRESHOLD=90
CONFIDENCE_MEDIUM_THRESHOLD=75
# Ignore money differences smaller than this many currency units.
MONEY_TOLERANCE_ABSOLUTE=1.00
MONEY_TOLERANCE_RELATIVE=0.005

# --- Reporting --------------------------------------------------------------
REPORTING_CURRENCY=USD
DEFAULT_AS_OF_DATE=2026-08-31
