# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Plain-English: these are the settings the app reads when it starts.
#
# Every value here is validated by backend/app/config.py. Names map one-to-one
# to Settings fields (upper-cased). If a required value is missing the app
# refuses to start and names the field, instead of guessing.
#
# NOTE: the app reads the process environment only. docker-compose.yml injects
# these into the containers; this .env file is what docker substitutes from.
# Nothing is read from disk at runtime.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Plain-English: where the app stores its data. Default works with docker-compose.
# POSTGRES_* are read by docker-compose only; the app itself uses DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revenue_leakage
POSTGRES_USER=rl_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://rl_app:change_me@localhost:5432/revenue_leakage

# --- LLM provider (OpenAI-compatible) ---------------------------------------
# Plain-English: which AI model does the reading and explaining.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, OpenRouter, local server).
# Required unless LLM_MOCK=1.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
# Model used for narrative writing. Falls back to LLM_MODEL if unset.
LLM_MODEL_NARRATIVE=

# --- Embeddings -------------------------------------------------------------
# Plain-English: turns contract clauses into vectors we can search.
# Some gateways need a prefix on the model id, e.g. openrouter/text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-small
# Ask for the width explicitly. pgvector cannot index vectors wider than 2000
# dimensions, and several gateways default to 3072 or 4096 unless told.
EMBEDDING_DIMENSIONS=1536
# Full embeddings URL. Leave blank to derive it from LLM_BASE_URL (the gateway
# we develop against serves chat at /v1 and embeddings at /api/v1/embeddings).
EMBEDDING_URL=

# --- Offline / test mode ----------------------------------------------------
# Plain-English: when true, no network calls are made. Tests always run offline.
LLM_MOCK=0
CUAD_OFFLINE=1

# --- CUAD real-data fetch ---------------------------------------------------
# Plain-English: the real public contract dataset used for testing (see ADR-007).
# Downloaded files are cached outside the repo and never committed.
CUAD_ZENODO_URL=https://zenodo.org/records/4595826/files/CUAD_v1.zip?download=1
CUAD_ZENODO_MD5=c38f490a984420b8a62600db401fafd5
CUAD_MAX_CONTRACTS=100
CUAD_CACHE_DIR=data/cuad

# --- Cloudflare AI Search (optional comparison baseline, see ADR-009) -------
# Plain-English: optional. Used ONLY to compare our own search against a
# managed service. Leave blank and the comparison is skipped.
CF_ACCOUNT_ID=
CF_AI_SEARCH_INSTANCE_ID=
CF_API_TOKEN=

# --- Detection tuning -------------------------------------------------------
# Plain-English: how confident the case must be before it is auto-confirmed.
CONFIDENCE_HIGH_THRESHOLD=90
CONFIDENCE_MEDIUM_THRESHOLD=75
# Ignore money differences smaller than this many currency units.
MONEY_TOLERANCE_ABS=1.00
# Ignore relative differences smaller than this fraction (0.005 == 0.5 percent).
MONEY_TOLERANCE_PCT=0.005

# --- Confidence weights (must sum to 1.0, see docs/confidence.md) -----------
CONFIDENCE_WEIGHT_EVIDENCE_COMPLETENESS=0.25
CONFIDENCE_WEIGHT_SOURCE_AGREEMENT=0.20
CONFIDENCE_WEIGHT_DETERMINISTIC_CERTAINTY=0.15
CONFIDENCE_WEIGHT_CONTRACT_CLARITY=0.10
CONFIDENCE_WEIGHT_EXCEPTION_ABSENCE=0.10
CONFIDENCE_WEIGHT_DATA_FRESHNESS=0.08
CONFIDENCE_WEIGHT_HISTORICAL_PRECEDENT=0.07
CONFIDENCE_WEIGHT_AMOUNT_MATERIALITY=0.05

# --- Agent budgets ----------------------------------------------------------
# Plain-English: how much work one investigation may do before it is stopped.
# Without these, one awkward contract could spend the whole API budget.
# Steps of reasoning allowed before a run ends as budget_exhausted.
AGENT_MAX_STEPS=12
# Tool (database read) calls allowed per investigation.
AGENT_MAX_TOOL_CALLS=24
# Tokens allowed per investigation.
AGENT_TOKEN_BUDGET=20000
# Wall-clock seconds allowed per investigation.
AGENT_TIMEOUT_SECONDS=120
# Retries for a failed provider call. Retries back off; our gateway answers
# HTTP 502 when its free pool is exhausted.
AGENT_MAX_RETRIES=2

# --- Reporting --------------------------------------------------------------
REPORTING_CURRENCY=USD
# Fallback only: money and period code always takes an as_of_date argument
# rather than reading the clock (AGENTS.md section 1.4).
DEFAULT_AS_OF_DATE=2026-08-31
